{
    "name": "contenir-extension/mailchimp",
    "description": "The Mailchimp add-on for Contenir CMS: keeps a Mailchimp audience in step with the site's sign-ups and records, through an outbox, and hears back about unsubscribes, cleaned addresses and complaints.",
    "type": "contenir-extension",
    "license": "BSD-3-Clause",
    "keywords": [
        "contenir",
        "contenir-extension",
        "mailchimp",
        "newsletter",
        "mailing-list",
        "audience"
    ],
    "support": {
        "issues": "https://github.com/contenir-extension/mailchimp/issues",
        "source": "https://github.com/contenir-extension/mailchimp"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/contenir/contenir-audience"
        }
    ],
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "contenir/contenir-audience": "^0.1",
        "contenir/contenir-extension-api": "^0.7.5",
        "guzzlehttp/guzzle": "^7.9",
        "php-db/phpdb": "^0.6.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "contenir/contenir-qa-tools": "0.1.x-dev",
        "infection/infection": "^0.34.1",
        "nyholm/psr7": "^1.8.2",
        "php-db/phpdb-sqlite": "0.3.x-dev",
        "phpunit/phpunit": "^11.5.42"
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Extension\\Mailchimp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Extension\\Mailchimp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "boundary": "extension-boundary",
        "check": [
            "@cs-check",
            "@static-analysis",
            "@test",
            "@test-integration",
            "@mutation-test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint",
            "mago guard"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "static-analysis": "mago analyze",
        "test": "phpunit --colors=always --testsuite unit",
        "test-integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml",
        "mutation-test": "infection"
    },
    "extra": {
        "contenir": {
            "handle": "mailchimp",
            "extension": "Contenir\\Extension\\Mailchimp\\MailchimpExtension"
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.99"
        },
        "sort-packages": true,
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
